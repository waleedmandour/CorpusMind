  <diagram id="fig0-corrected" name="fig0_design_principles (corrected 2026-11-05)">
    <mxGraphModel dx="1540" dy="1400" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1540" pageHeight="1400" math="0" shadow="0" background="#FFFFFF">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="band1" value="" style="rounded=1;arcSize=2;fillColor=#EAF3FB;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry x="70" y="60" width="1400" height="310" as="geometry" />
        </mxCell>
        <mxCell id="band1_bar" value="" style="rounded=0;fillColor=#0072B2;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry x="94" y="82" width="6" height="26" as="geometry" />
        </mxCell>
        <mxCell id="band1_title" value="&lt;b style=&quot;font-size:17px;&quot;&gt;Data sovereignty &amp;amp; ethics&lt;/b&gt;&amp;nbsp;&amp;nbsp;&lt;font style=&quot;font-size:12px;&quot; color=&quot;#64748B&quot;&gt;where the data lives, and who is protected&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=middle;fontColor=#1F2937;" vertex="1" parent="1">
          <mxGeometry x="108" y="78" width="1300" height="34" as="geometry" />
        </mxCell>
        <mxCell id="band2" value="" style="rounded=1;arcSize=2;fillColor=#E8F5F0;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry x="70" y="395" width="1400" height="350" as="geometry" />
        </mxCell>
        <mxCell id="band2_bar" value="" style="rounded=0;fillColor=#009E73;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry x="94" y="417" width="6" height="26" as="geometry" />
        </mxCell>
        <mxCell id="band2_title" value="&lt;b style=&quot;font-size:17px;&quot;&gt;Epistemic discipline&lt;/b&gt;&amp;nbsp;&amp;nbsp;&lt;font style=&quot;font-size:12px;&quot; color=&quot;#64748B&quot;&gt;how every claim is produced&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=middle;fontColor=#1F2937;" vertex="1" parent="1">
          <mxGeometry x="108" y="413" width="1300" height="34" as="geometry" />
        </mxCell>
        <mxCell id="band3" value="" style="rounded=1;arcSize=2;fillColor=#FDF1E6;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry x="70" y="770" width="1400" height="350" as="geometry" />
        </mxCell>
        <mxCell id="band3_bar" value="" style="rounded=0;fillColor=#D55E00;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry x="94" y="792" width="6" height="26" as="geometry" />
        </mxCell>
        <mxCell id="band3_title" value="&lt;b style=&quot;font-size:17px;&quot;&gt;Verifiable honesty&lt;/b&gt;&amp;nbsp;&amp;nbsp;&lt;font style=&quot;font-size:12px;&quot; color=&quot;#64748B&quot;&gt;how results stay auditable and trustworthy&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=middle;fontColor=#1F2937;" vertex="1" parent="1">
          <mxGeometry x="108" y="788" width="1300" height="34" as="geometry" />
        </mxCell>
        <mxCell id="band4" value="" style="rounded=1;arcSize=2;fillColor=#F9EEF4;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry x="70" y="1145" width="1400" height="176" as="geometry" />
        </mxCell>
        <mxCell id="band4_bar" value="" style="rounded=0;fillColor=#CC79A7;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry x="94" y="1167" width="6" height="26" as="geometry" />
        </mxCell>
        <mxCell id="band4_title" value="&lt;b style=&quot;font-size:17px;&quot;&gt;Cross-cutting principle&lt;/b&gt;&amp;nbsp;&amp;nbsp;&lt;font style=&quot;font-size:12px;&quot; color=&quot;#64748B&quot;&gt;the linguistic-coverage mandate that spans all three families&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=middle;fontColor=#1F2937;" vertex="1" parent="1">
          <mxGeometry x="108" y="1163" width="1300" height="34" as="geometry" />
        </mxCell>
        <mxCell id="c_p1" value="&lt;span style=&quot;border:1.5px solid #0072B2;color:#0072B2;border-radius:10px;padding:1px 8px;font-size:11px;font-weight:bold;&quot;&gt;P1&lt;/span&gt;&amp;nbsp;&amp;nbsp;&lt;b style=&quot;font-size:14px;&quot;&gt;Local-first, cloud-optional&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;Corpus text, images and AI queries never leave the researcher's machine unless explicitly opted in.&lt;br/&gt;&lt;br/&gt;&lt;b&gt;&lt;font color=&quot;#0072B2&quot;&gt;ENFORCED BY&lt;/font&gt;&lt;/b&gt; &lt;font color=&quot;#64748B&quot;&gt;cloud providers ship disabled; a server-mode hard-disable switch makes cloud calls fail closed.&lt;/font&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0072B2;strokeWidth=2;align=left;verticalAlign=top;spacing=14;spacingTop=12;spacingLeft=16;spacingRight=14;fontSize=12;fontColor=#1F2937;" vertex="1" parent="1">
          <mxGeometry x="95" y="124" width="655" height="224" as="geometry" />
        </mxCell>
        <mxCell id="c_p9" value="&lt;span style=&quot;border:1.5px solid #0072B2;color:#0072B2;border-radius:10px;padding:1px 8px;font-size:11px;font-weight:bold;&quot;&gt;P9&lt;/span&gt;&amp;nbsp;&amp;nbsp;&lt;b style=&quot;font-size:14px;&quot;&gt;Consent and restraint around biometric-adjacent features&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;Facial and body inference serves media studies yet is legally and ethically sensitive.&lt;br/&gt;&lt;br/&gt;&lt;b&gt;&lt;font color=&quot;#0072B2&quot;&gt;ENFORCED BY&lt;/font&gt;&lt;/b&gt; &lt;font color=&quot;#64748B&quot;&gt;opt-in module, off by default, with an in-app notice; never identity recognition or re-identification.&lt;/font&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0072B2;strokeWidth=2;align=left;verticalAlign=top;spacing=14;spacingTop=12;spacingLeft=16;spacingRight=14;fontSize=12;fontColor=#1F2937;" vertex="1" parent="1">
          <mxGeometry x="790" y="124" width="655" height="224" as="geometry" />
        </mxCell>
        <mxCell id="c_p2" value="&lt;span style=&quot;border:1.5px solid #009E73;color:#009E73;border-radius:10px;padding:1px 8px;font-size:11px;font-weight:bold;&quot;&gt;P2&lt;/span&gt;&amp;nbsp;&amp;nbsp;&lt;b style=&quot;font-size:14px;&quot;&gt;Grounded AI, never a bare chatbot&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;Every empirical claim must cite engine evidence that the engine can reproduce on demand.&lt;br/&gt;&lt;br/&gt;&lt;b&gt;&lt;font color=&quot;#009E73&quot;&gt;ENFORCED BY&lt;/font&gt;&lt;/b&gt; &lt;font color=&quot;#64748B&quot;&gt;the 27-tool agent runs the same deterministic functions as the UI; ungrounded claims are flagged, never asserted.&lt;/font&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#009E73;strokeWidth=2;align=left;verticalAlign=top;spacing=14;spacingTop=12;spacingLeft=16;spacingRight=14;fontSize=12;fontColor=#1F2937;" vertex="1" parent="1">
          <mxGeometry x="95" y="459" width="436" height="262" as="geometry" />
        </mxCell>
        <mxCell id="c_p3" value="&lt;span style=&quot;border:1.5px solid #009E73;color:#009E73;border-radius:10px;padding:1px 8px;font-size:11px;font-weight:bold;&quot;&gt;P3&lt;/span&gt;&amp;nbsp;&amp;nbsp;&lt;b style=&quot;font-size:14px;&quot;&gt;Effect size and significance, always together&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;A key word is never reported as important on frequency grounds alone.&lt;br/&gt;&lt;br/&gt;&lt;b&gt;&lt;font color=&quot;#009E73&quot;&gt;ENFORCED BY&lt;/font&gt;&lt;/b&gt; &lt;font color=&quot;#64748B&quot;&gt;eight association tests (MI, T-score, log-likelihood, Dice, log-Dice, chi-square, delta-P, Fisher) beside four effect sizes (Log Ratio, %DIFF, Simple Maths, Odds Ratio).&lt;/font&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#009E73;strokeWidth=2;align=left;verticalAlign=top;spacing=14;spacingTop=12;spacingLeft=16;spacingRight=14;fontSize=12;fontColor=#1F2937;" vertex="1" parent="1">
          <mxGeometry x="552" y="459" width="436" height="262" as="geometry" />
        </mxCell>
        <mxCell id="c_p5" value="&lt;span style=&quot;border:1.5px solid #009E73;color:#009E73;border-radius:10px;padding:1px 8px;font-size:11px;font-weight:bold;&quot;&gt;P5&lt;/span&gt;&amp;nbsp;&amp;nbsp;&lt;b style=&quot;font-size:14px;&quot;&gt;Interpretive claims are hypotheses, not facts&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;Ideology and CDA outputs carry the lens that produced them and await human confirmation.&lt;br/&gt;&lt;br/&gt;&lt;b&gt;&lt;font color=&quot;#009E73&quot;&gt;ENFORCED BY&lt;/font&gt;&lt;/b&gt; &lt;font color=&quot;#64748B&quot;&gt;twelve built-in theoretical frameworks (CDA, MCDA, SFL, appraisal&amp;#8230;); findings stay framework-attributed readings until confirmed.&lt;/font&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#009E73;strokeWidth=2;align=left;verticalAlign=top;spacing=14;spacingTop=12;spacingLeft=16;spacingRight=14;fontSize=12;fontColor=#1F2937;" vertex="1" parent="1">
          <mxGeometry x="1009" y="459" width="436" height="262" as="geometry" />
        </mxCell>
        <mxCell id="c_p4" value="&lt;span style=&quot;border:1.5px solid #D55E00;color:#D55E00;border-radius:10px;padding:1px 8px;font-size:11px;font-weight:bold;&quot;&gt;P4&lt;/span&gt;&amp;nbsp;&amp;nbsp;&lt;b style=&quot;font-size:14px;&quot;&gt;Zero-code, not zero-transparency&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;One-click outputs stay inspectable: which model, formula and version produced them.&lt;br/&gt;&lt;br/&gt;&lt;b&gt;&lt;font color=&quot;#D55E00&quot;&gt;ENFORCED BY&lt;/font&gt;&lt;/b&gt; &lt;font color=&quot;#64748B&quot;&gt;measure and parameters shown on every result; a one-click auto-drafted Methods section is exportable for papers.&lt;/font&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D55E00;strokeWidth=2;align=left;verticalAlign=top;spacing=14;spacingTop=12;spacingLeft=16;spacingRight=14;fontSize=12;fontColor=#1F2937;" vertex="1" parent="1">
          <mxGeometry x="95" y="834" width="436" height="262" as="geometry" />
        </mxCell>
        <mxCell id="c_p7" value="&lt;span style=&quot;border:1.5px solid #D55E00;color:#D55E00;border-radius:10px;padding:1px 8px;font-size:11px;font-weight:bold;&quot;&gt;P7&lt;/span&gt;&amp;nbsp;&amp;nbsp;&lt;b style=&quot;font-size:14px;&quot;&gt;Practical scale, honestly stated&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;No unlimited promises &amp;#8212; interactive analysis is measured on ~100K-token corpora on consumer hardware; synthetic stress runs reach 10M tokens; production scale (millions of tokens) is a stated roadmap item.&lt;br/&gt;&lt;br/&gt;&lt;b&gt;&lt;font color=&quot;#D55E00&quot;&gt;ENFORCED BY&lt;/font&gt;&lt;/b&gt; &lt;font color=&quot;#64748B&quot;&gt;disk-backed, incrementally indexed corpora; bounded tables and job time caps with clear in-UI feedback.&lt;/font&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D55E00;strokeWidth=2;align=left;verticalAlign=top;spacing=14;spacingTop=12;spacingLeft=16;spacingRight=14;fontSize=12;fontColor=#1F2937;" vertex="1" parent="1">
          <mxGeometry x="552" y="834" width="436" height="262" as="geometry" />
        </mxCell>
        <mxCell id="c_p8" value="&lt;span style=&quot;border:1.5px solid #D55E00;color:#D55E00;border-radius:10px;padding:1px 8px;font-size:11px;font-weight:bold;&quot;&gt;P8&lt;/span&gt;&amp;nbsp;&amp;nbsp;&lt;b style=&quot;font-size:14px;&quot;&gt;Reproducibility is a feature&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;Every project pins the exact tokenizer, tagger, model and formula versions used.&lt;br/&gt;&lt;br/&gt;&lt;b&gt;&lt;font color=&quot;#D55E00&quot;&gt;ENFORCED BY&lt;/font&gt;&lt;/b&gt; &lt;font color=&quot;#64748B&quot;&gt;re-analysis creates a new annotation version instead of overwriting; exports can cite versions and formulas.&lt;/font&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D55E00;strokeWidth=2;align=left;verticalAlign=top;spacing=14;spacingTop=12;spacingLeft=16;spacingRight=14;fontSize=12;fontColor=#1F2937;" vertex="1" parent="1">
          <mxGeometry x="1009" y="834" width="436" height="262" as="geometry" />
        </mxCell>
        <mxCell id="c_p6" value="&lt;span style=&quot;border:1.5px solid #CC79A7;color:#CC79A7;border-radius:10px;padding:1px 8px;font-size:11px;font-weight:bold;&quot;&gt;P6&lt;/span&gt;&amp;nbsp;&amp;nbsp;&lt;b style=&quot;font-size:14px;&quot;&gt;Arabic is a first-class citizen, not a bolt-on&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;RTL layout and the Arabic tool ecosystem belong to the core architecture from day one.&lt;br/&gt;&lt;br/&gt;&lt;b&gt;&lt;font color=&quot;#CC79A7&quot;&gt;ENFORCED BY&lt;/font&gt;&lt;/b&gt; &lt;font color=&quot;#64748B&quot;&gt;full RTL interface mirroring; CAMeL Tools morphology and variety identification in the engine core; one analysis surface across English, Arabic, Urdu, Hindi and Persian.&lt;/font&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CC79A7;strokeWidth=2;align=left;verticalAlign=top;spacing=14;spacingTop=12;spacingLeft=16;spacingRight=14;fontSize=12;fontColor=#1F2937;" vertex="1" parent="1">
          <mxGeometry x="95" y="1207" width="1350" height="100" as="geometry" />
        </mxCell>
        <mxCell id="footer" value="None of the nine is aspirational: each card names the shipped mechanism that enforces it." style="text;html=1;align=center;verticalAlign=middle;fontSize=12;fontColor=#94A3B8;fontStyle=2;" vertex="1" parent="1">
          <mxGeometry x="70" y="1332" width="1400" height="30" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
